[connection signal="pressed" from="VBoxContainer/btn_criar" to="." method="_on_criar_pressed"]
[connection signal="pressed" from="VBoxContainer/HBoxFilters/refresh_btn" to="." method="_on_refresh_pressed"]
[connection signal="pressed" from="VBoxContainer/HBoxActions/join_btn" to="." method="_on_join_pressed"]
[connection signal="pressed" from="VBoxContainer/HBoxActions/back_btn" to="." method="_on_back_pressed"]
[connection signal="text_changed" from="VBoxContainer/search_input" to="." method="_on_search_input_changed"]
