[gd_scene format=3 uid="uid://dxhkr6w6senii"]

[ext_resource type="Script" path="res://scripts/ui/lobby_browser.gd" id="1"]

[node name="Control" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="VBoxContainer" type="VBoxContainer" parent="."]
layout_mode = 0
offset_right = 40.0
offset_bottom = 40.0

[node name="title" type="Label" parent="VBoxContainer"]
layout_mode = 2
text = "Procurar Lobbies"

[node name="btn_criar" type="Button" parent="VBoxContainer"]
layout_mode = 2
text = "Criar Lobby"

[node name="search_input" type="LineEdit" parent="VBoxContainer"]
layout_mode = 2
