[node name="HBoxFilters" type="HBoxContainer" parent="VBoxContainer"]
layout_mode = 2

[node name="dist_label" type="Label" parent="VBoxContainer/HBoxFilters"]
layout_mode = 2
text = "Distancia:"

[node name="filter_distance" type="OptionButton" parent="VBoxContainer/HBoxFilters"]
layout_mode = 2

[node name="filter_password" type="CheckBox" parent="VBoxContainer/HBoxFilters"]
layout_mode = 2
text = "Sem password"

[node name="refresh_btn" type="Button" parent="VBoxContainer/HBoxFilters"]
layout_mode = 2
text = "Atualizar"

[node name="lobby_list" type="ItemList" parent="VBoxContainer"]
layout_mode = 2
size_flags_vertical = 3

[node name="HBoxActions" type="HBoxContainer" parent="VBoxContainer"]
layout_mode = 2

[node name="join_btn" type="Button" parent="VBoxContainer/HBoxActions"]
layout_mode = 2
