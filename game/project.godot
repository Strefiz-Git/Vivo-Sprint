; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Vivo Sprint"
run/main_scene="uid://bkyy1qg8cjwkq"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

logger="*res://scripts/logger.gd"
globals="*res://scripts/globals.gd"
event_bus="*res://scripts/event_bus.gd"
helpers="*res://scripts/helpers.gd"
settings="*res://scripts/settings.gd"
scene_manager="*res://scripts/ui/scene_manager.gd"
steam_manager="*res://scripts/steam/steam_manager.gd"
steam_achievements="*res://scripts/steam/steam_achievements.gd"
steam_voice="*res://scripts/steam/steam_voice.gd"
network_manager="*res://scripts/network/network_manager.gd"
server_config="*res://scripts/network/server_config.gd"
dedicated_server="*res://scripts/network/dedicated_server.gd"
race_manager="*res://scripts/race/race_manager.gd"
locale_manager="*res://scripts/localization/locale_manager.gd"
resource_cache="*res://scripts/resource_cache.gd"
units_manager="*res://scripts/units_manager.gd"

